#!/usr/bin/env bash
set -euo pipefail

OWNER_REPO="iczelia/c-arbint"
API_URL="https://api.github.com/repos/${OWNER_REPO}/releases/latest"

need() { command -v "$1" >/dev/null 2>&1 || { echo "error: missing dependency: $1" >&2; exit 1; }; }
need curl
need jq
need gpg
need sha512sum
need tar
need zip

workdir="${1:-release-assets}"
mkdir -p "$workdir"
cd "$workdir"

echo "Fetching latest release metadata for ${OWNER_REPO}..."
json="$(curl -fsSL "$API_URL")"

tag="$(jq -r '.tag_name // empty' <<<"$json")"
name="$(jq -r '.name // empty' <<<"$json")"
assets_count="$(jq -r '.assets | length' <<<"$json")"

if [[ -z "${tag}" ]]; then
  echo "error: could not determine latest release tag (API rate limit? repo missing?)" >&2
  exit 1
fi
if [[ "$assets_count" -eq 0 ]]; then
  echo "error: latest release (${tag}) has no assets to download" >&2
  exit 1
fi

echo "Latest release: tag=${tag} name=${name:-"(no name)"} assets=${assets_count}"
echo

# Download all assets into workdir/
echo "Downloading assets..."
jq -r '.assets[] | [.name, .browser_download_url] | @tsv' <<<"$json" |
while IFS=$'\t' read -r asset_name asset_url; do
  echo "  - $asset_name"
  curl -fL --retry 5 --retry-delay 2 -o "$asset_name" "$asset_url" \
    -H 'User-Agent: Mozilla/5.0 (X11; Linux x86_64; rv:140.0) Gecko/20100101 Firefox/140.0'
done
echo

# Create a sha512 manifest (useful for later verification)
echo "Writing SHA-512 manifest..."
sha512sum -- * > SHA512SUMS.txt
echo "  -> SHA512SUMS.txt"
echo

# Sign each downloaded file with a detached signature (SHA-512 digest)
# NOTE: This produces binary .sig files. If you prefer ASCII-armored signatures for concatenation,
# add: --armor
echo "Signing assets (detached signatures)..."
sig_list=()
for f in *; do
  [[ -f "$f" ]] || continue
  [[ "$f" == *.sig ]] && continue
  [[ "$f" == "SHA512SUMS.txt" ]] && continue

  out="${f}.sig"
  echo "  - gpg signing: $f -> $out"
  gpg --sign --detach-sign --armor --interactive --verbose --digest-algo sha512 -o "$out" "$f"
  sig_list+=("$out")
done
echo

# Package signatures and SHA sums into archives
# Create a temporary directory for the signature bundle
bundle_dir="${tag}-signatures"
mkdir -p "$bundle_dir"

# Copy all .sig files and SHA512SUMS.txt into the bundle directory
for sig in "${sig_list[@]}"; do
  cp "$sig" "$bundle_dir/"
done
cp SHA512SUMS.txt "$bundle_dir/"

echo "Creating signature archives..."

# Create tar.xz archive
tar_xz="${bundle_dir}.tar.xz"
tar -cJf "$tar_xz" "$bundle_dir"
echo "  - $tar_xz"

# Create tar.gz archive
tar_bz3="${bundle_dir}.tar.bz3"
tar -c "$bundle_dir" | bzip3 -vfe > "$tar_bz3"
echo "  - $tar_bz3"

# Create zip archive
zip_file="${bundle_dir}.zip"
zip -rq "$zip_file" "$bundle_dir"
echo "  - $zip_file"

# Clean up the temporary bundle directory
rm -rf "$bundle_dir"

echo
echo "Done."
echo "Signature archives created:"
echo "  - $tar_xz"
echo "  - $tar_gz"
echo "  - $zip_file"
echo "Individual .sig files and SHA512SUMS.txt remain in $workdir/"
