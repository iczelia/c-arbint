.\" =========================================================================
.\"  c-arbint -- Portable Arbitrary-Precision Integer Library
.\" =========================================================================
.TH C-ARBINT 3 "@MAN_DATE@" "c-arbint @PACKAGE_VERSION@" "Library Functions Manual"
.\" -------------------------------------------------------------------------
.SH NAME
.\" -------------------------------------------------------------------------
c-arbint \- portable arbitrary-precision integer library for C
.\" -------------------------------------------------------------------------
.SH SYNOPSIS
.\" -------------------------------------------------------------------------
.nf
.B #include <arbint.h>
.fi
.PP
Link with:
.PP
.RS 4
.nf
.B cc program.c $(pkg-config --cflags --libs c-arbint)
.fi
.RE
.\" -------------------------------------------------------------------------
.SH DESCRIPTION
.\" -------------------------------------------------------------------------
.B c-arbint
is a signed arbitrary-precision integer library providing explicit
allocator-aware object management and runtime performance optimization.
.PP
The library automatically dispatches to optimized code paths based on
detected CPU features:
.PP
.RS 4
.TS
tab(|);
lb lb
l l.
Platform|Accelerated Operations
_
x86/x86-64|BMI2 (multiply, NTT), AVX2 (doubling, NTT), POPCNT, SHA-NI, SSE4.2
AArch64|CRC32, PMULL (hashing)
.TE
.RE
.\" =========================================================================
.\"                              TYPES
.\" =========================================================================
.SH TYPES
.\" -------------------------------------------------------------------------
.SS Core Types
.\" -------------------------------------------------------------------------
.TP 18
.B arbint_t
Arbitrary-precision integer.
Declare as a local variable; initialize with
.BR arbint_init ()
before use and release with
.BR arbint_clear ()
when done.
Uses the single-object array idiom for pass-by-reference semantics.
.TP
.B arbint_ctx_t
Allocation context.
Carries the memory allocator used for all object storage and exported buffers.
Multiple integers can share a single context.
.TP
.B arbint_err_t
Error code enumeration returned by all fallible operations.
See
.B ERROR CODES
below.
.TP
.B arbint_rng_t
Mersenne Twister (MT19937) pseudo-random number generator state.
Initialize with
.BR arbint_rng_init ()
and release with
.BR arbint_rng_clear ().
.\" =========================================================================
.\"                           ERROR CODES
.\" =========================================================================
.SH ERROR CODES
.PP
Functions returning
.B arbint_err_t
yield
.B ARBINT_OK
(zero) on success.
Nonzero values indicate failure:
.PP
.TS
tab(|);
lb lbw(50)
l l.
Code|Meaning
_
ARBINT_EINVAL|T{
Invalid argument: NULL pointer, invalid object state, or malformed input.
T}
ARBINT_ENOMEM|T{
Memory allocation failed.
T}
ARBINT_EOVERFLOW|T{
Numeric overflow or capacity exceeded for the requested operation.
T}
ARBINT_ESIGN|T{
Attempted unsigned extraction from a negative value.
T}
ARBINT_EDOM|T{
Domain error: e.g., square root of negative, entropy source failure,
or non-positive bound for random generation.
T}
ARBINT_EZERO|T{
Division by zero.
T}
.TE
.PP
Comparison and predicate functions return
.B int
values: boolean 0/1 for predicates, or three-way \-1/0/+1 for comparisons.
.\" =========================================================================
.\"                         API REFERENCE
.\" =========================================================================
.SH API REFERENCE
.\" -------------------------------------------------------------------------
.SS Initialization and Cleanup
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_ctx_init_default(arbint_ctx_t *" ctx ")"
.br
.BI "arbint_err_t arbint_ctx_init(arbint_ctx_t *" ctx ", arbint_alloc_t " alloc ")"
.br
.BI "void arbint_ctx_clear(arbint_ctx_t *" ctx ")"
.br
.BI "void arbint_drop_caches(void)"
.RS 4
.PP
Initialize or destroy an allocation context.
.BR arbint_ctx_init_default ()
uses the standard C allocator (malloc/realloc/free).
.BR arbint_ctx_init ()
accepts a custom allocator.
.BR arbint_drop_caches ()
explicitly releases global runtime caches and is safe to call repeatedly.
.RE
.PP
.BI "arbint_err_t arbint_init(arbint_t " x ", arbint_ctx_t *" ctx ")"
.br
.BI "void arbint_clear(arbint_t " x ")"
.RS 4
.PP
Initialize a single integer to zero, or release its storage.
Every
.BR arbint_init ()
must be paired with exactly one
.BR arbint_clear ().
.RE
.PP
.BI "arbint_err_t arbint_init_all(arbint_ctx_t *" ctx ", arbint_t " a ", ...)"
.RS 4
.PP
Initialize multiple integers with the same context.
The variadic list must end with a
.B "(arbint_t *) NULL"
sentinel.
On failure, all previously initialized values are cleared automatically.
.RE
.PP
.BI "void arbint_clear_all(arbint_t " a ", ...)"
.RS 4
.PP
Clear multiple integers.
The variadic list must end with a
.B "(arbint_t *) NULL"
sentinel.
.RE
.PP
.BI "arbint_ctx_t * arbint_get_ctx(const arbint_t " x ")"
.br
.BI "void arbint_set_ctx(arbint_t " x ", arbint_ctx_t *" ctx ")"
.RS 4
.PP
Query or rebind an integer's allocation context.
.RE
.PP
.BI "void arbint_zero(arbint_t " x ")"
.br
.BI "arbint_err_t arbint_resize(arbint_t " x ", size_t " cap ")"
.br
.BI "void arbint_swap(arbint_t " a ", arbint_t " b ")"
.RS 4
.PP
Reset to zero, reserve limb capacity, or exchange two integers' state.
.RE
.\" -------------------------------------------------------------------------
.SS Assignment
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_set(arbint_t " rop ", const arbint_t " op ")"
.br
.BI "arbint_err_t arbint_set_i32(arbint_t " rop ", int32_t " val ")"
.br
.BI "arbint_err_t arbint_set_u32(arbint_t " rop ", uint32_t " val ")"
.RS 4
.PP
Set
.I rop
from another integer or a 32-bit scalar.
.RE
.\" -------------------------------------------------------------------------
.SS String Conversion
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_set_str(arbint_t " rop ", const char *" s ", int " base ")"
.RS 4
.PP
Parse an integer from string
.I s
in the given
.IR base .
The string may have an optional leading '+' or '-' sign, followed by
digits appropriate for the base.
Leading whitespace is not skipped.
.PP
.I base
must be in the range 2-62, or 0 for auto-detection:
.RS 4
.IP \(bu 2
Base 0: "0x" or "0X" prefix indicates hexadecimal, "0b" or "0B" indicates
binary, "0" prefix indicates octal, otherwise decimal.
.IP \(bu 2
Bases 2-36: digits are '0'-'9' and 'a'-'z' (or 'A'-'Z'), case-insensitive.
.IP \(bu 2
Bases 37-62: digits are '0'-'9', 'A'-'Z' (values 10-35), then 'a'-'z'
(values 36-61), case-sensitive.
.RE
.PP
Returns
.B ARBINT_EINVAL
if
.I base
is out of range, the string is empty, or contains invalid characters
for the specified base.
.RE
.PP
.BI "arbint_err_t arbint_get_str(const arbint_t " op ", char **" out_str ", int " base ")"
.RS 4
.PP
Format
.I op
as a string in the given
.IR base .
The result is allocated using the source object's context allocator
and stored in
.IR *out_str .
The caller must free it with the same allocator.
.PP
.I base
must be in the range 2-62, or negative for uppercase output (bases 2-36 only).
For example, base -16 produces "1A2B" instead of "1a2b".
.PP
Negative numbers are formatted with a leading '-' sign.
Zero is formatted as "0".
.RE
.\" -------------------------------------------------------------------------
.SS Extraction
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_get_i32(const arbint_t " op ", int32_t *" out ")"
.br
.BI "arbint_err_t arbint_get_u32(const arbint_t " op ", uint32_t *" out ")"
.RS 4
.PP
Extract to a 32-bit scalar.
Returns
.B ARBINT_EOVERFLOW
if the value does not fit, or
.B ARBINT_ESIGN
for unsigned extraction of a negative value.
.RE
.\" -------------------------------------------------------------------------
.SS Representability Predicates
.\" -------------------------------------------------------------------------
.PP
.nf
.BI "int arbint_fits_u8(const arbint_t " x ")"
.BI "int arbint_fits_u16(const arbint_t " x ")"
.BI "int arbint_fits_u32(const arbint_t " x ")"
.BI "int arbint_fits_u64(const arbint_t " x ")"
.BI "int arbint_fits_i8(const arbint_t " x ")"
.BI "int arbint_fits_i16(const arbint_t " x ")"
.BI "int arbint_fits_i32(const arbint_t " x ")"
.BI "int arbint_fits_i64(const arbint_t " x ")"
.fi
.RS 4
.PP
Return 1 if
.I x
fits in the indicated type without truncation or sign error, 0 otherwise.
Non-allocating.
.RE
.\" -------------------------------------------------------------------------
.SS Sign and Shape Predicates
.\" -------------------------------------------------------------------------
.PP
.nf
.BI "int arbint_signum(const arbint_t " x ")"
.BI "int arbint_is_zero(const arbint_t " x ")"
.BI "int arbint_is_one(const arbint_t " x ")"
.BI "int arbint_is_neg(const arbint_t " x ")"
.BI "int arbint_is_odd(const arbint_t " x ")"
.BI "int arbint_is_even(const arbint_t " x ")"
.fi
.RS 4
.PP
Query sign and basic shape.
.BR arbint_signum ()
returns \-1, 0, or +1.
Others return boolean 0/1.
.RE
.PP
.BI "arbint_err_t arbint_abs(arbint_t " rop ", const arbint_t " op ")"
.br
.BI "arbint_err_t arbint_neg(arbint_t " rop ", const arbint_t " op ")"
.RS 4
.PP
Set
.I rop
to the absolute value or negation of
.IR op .
.I rop
may alias
.IR op .
.RE
.\" -------------------------------------------------------------------------
.SS Comparison
.\" -------------------------------------------------------------------------
.PP
.B Three-way comparisons
return \-1 if
.I a < b,
0 if
.I a == b,
or +1 if
.I a > b.
.PP
.nf
.BI "int arbint_cmp(const arbint_t " a ", const arbint_t " b ")"
.BI "int arbint_cmpabs(const arbint_t " a ", const arbint_t " b ")"
.BI "int arbint_cmp_i32(const arbint_t " a ", int32_t " b ")"
.BI "int arbint_cmp_u32(const arbint_t " a ", uint32_t " b ")"
.fi
.PP
.B Relational predicates
return 1 if the relation holds, 0 otherwise.
.PP
.TS
tab(|);
lb lb lb
l l l.
Big x Big|Big x i32|Big x u32
_
arbint_eq|arbint_eq_i32|arbint_eq_u32
arbint_ne|arbint_ne_i32|arbint_ne_u32
arbint_lt|arbint_lt_i32|arbint_lt_u32
arbint_le|arbint_le_i32|arbint_le_u32
arbint_gt|arbint_gt_i32|arbint_gt_u32
arbint_ge|arbint_ge_i32|arbint_ge_u32
.TE
.\" -------------------------------------------------------------------------
.SS Basic Arithmetic
.\" -------------------------------------------------------------------------
.PP
All arithmetic operations allow
.I rop
to alias any input operand.
.PP
.BI "arbint_err_t arbint_add(arbint_t " rop ", const arbint_t " a ", const arbint_t " b ")"
.br
.BI "arbint_err_t arbint_sub(arbint_t " rop ", const arbint_t " a ", const arbint_t " b ")"
.br
.BI "arbint_err_t arbint_mul(arbint_t " rop ", const arbint_t " a ", const arbint_t " b ")"
.br
.BI "arbint_err_t arbint_sqr(arbint_t " rop ", const arbint_t " a ")"
.RS 4
.PP
Compute
.IR rop " = " a " + " b ,
.IR rop " = " a " - " b ,
.IR rop " = " a " * " b ,
or
.IR rop " = " a "^2" .
.RE
.PP
.B Scalar variants
provide optimized paths for 32-bit operands:
.PP
.TS
tab(|);
lb lb
l l.
Signed (i32)|Unsigned (u32)
_
arbint_add_i32|arbint_add_u32
arbint_sub_i32|arbint_sub_u32
arbint_mul_i32|arbint_mul_u32
.TE
.\" -------------------------------------------------------------------------
.SS Fused Multiply-Accumulate
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_addmul(arbint_t " a ", const arbint_t " b ", const arbint_t " c ")"
.br
.BI "arbint_err_t arbint_submul(arbint_t " a ", const arbint_t " b ", const arbint_t " c ")"
.RS 4
.PP
Compute
.IR a " += " b " * " c
or
.IR a " -= " b " * " c .
.I a
may alias
.I b
or
.IR c .
.PP
For small operands (below Karatsuba threshold), a fused schoolbook loop
avoids temporary allocation.
Larger operands use the full recursive multiplication pipeline.
.RE
.PP
.BI "arbint_err_t arbint_addmul_u32(arbint_t " a ", const arbint_t " b ", uint32_t " c ")"
.br
.BI "arbint_err_t arbint_addmul_i32(arbint_t " a ", const arbint_t " b ", int32_t " c ")"
.br
.BI "arbint_err_t arbint_submul_u32(arbint_t " a ", const arbint_t " b ", uint32_t " c ")"
.br
.BI "arbint_err_t arbint_submul_i32(arbint_t " a ", const arbint_t " b ", int32_t " c ")"
.RS 4
.PP
Scalar variants using a single-limb fused loop.
.RE
.\" -------------------------------------------------------------------------
.SS Exponentiation
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_pow_u32(arbint_t " rop ", const arbint_t " base ", uint32_t " exp ")"
.RS 4
.PP
Compute
.IR rop " = " base "^" exp
using binary exponentiation (repeated squaring).
Requires O(log
.IR exp )
multiplications.
.I rop
may alias
.IR base .
The convention 0^0 = 1 is followed.
.RE
.PP
.BI "arbint_err_t arbint_pow_u32u32_tmod(arbint_t " rop ", const arbint_t " base ", uint32_t " exp ", uint32_t " mod ")"
.RS 4
.PP
Compute
.IR rop " = " base "^" exp " mod " mod .
Uses precomputed Barrett reduction for efficiency.
Returns
.B ARBINT_EZERO
if
.I mod
is 0.
If
.I mod
is 1, result is always 0.
.I rop
may alias
.IR base .
.RE
.\" -------------------------------------------------------------------------
.SS Integer Roots
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_isqrt(arbint_t " rop ", const arbint_t " a ")"
.RS 4
.PP
Compute
.IR rop " = floor(sqrt(" a "))."
Returns
.B ARBINT_EDOM
if
.I a
is negative.
.I rop
may alias
.IR a .
Uses Newton's method with quadratic convergence.
.RE
.PP
.BI "arbint_err_t arbint_root(arbint_t " rop ", const arbint_t " a ", uint32_t " k ")"
.RS 4
.PP
Compute the integer
.IR k "-th root:"
.IR rop " = floor(" a "^(1/" k "))."
Returns
.B ARBINT_EDOM
if
.I k
is zero or if
.I a
is negative.
For
.IR k "=2,"
delegates to
.BR arbint_isqrt ()
for efficiency.
For
.IR k "=1,"
simply copies
.IR a .
Uses generalized Newton iteration with quadratic convergence.
.I rop
may alias
.IR a .
.RE
.\" -------------------------------------------------------------------------
.SS Combinatorial Functions
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_fac_u32(arbint_t " rop ", uint32_t " n ")"
.RS 4
.PP
Compute
.IR rop " = " n "!."
Returns
.B ARBINT_EINVAL
if
.I rop
is NULL.
.RE
.PP
.BI "arbint_err_t arbint_bin_u32u32(arbint_t " rop ", uint32_t " n ", uint32_t " k ")"
.RS 4
.PP
Compute the binomial coefficient
.IR rop " = C(" n ", " k ")."
Returns 0 if
.I k
>
.IR n .
.RE
.PP
.BI "arbint_err_t arbint_fib_u32(arbint_t " rop ", uint32_t " n ")"
.RS 4
.PP
Compute the
.IR n "-th Fibonacci number F(" n ")."
F(0) = 0, F(1) = 1.
Uses O(log n) multiplications via fast doubling.
.RE
.PP
.BI "arbint_err_t arbint_lucas_u32(arbint_t " rop ", uint32_t " n ")"
.RS 4
.PP
Compute the
.IR n "-th Lucas number L(" n ")."
L(0) = 2, L(1) = 1.
Uses O(log n) multiplications.
.RE
.PP
.BI "arbint_err_t arbint_primorial(arbint_t " rop ", const arbint_t " n ")"
.RS 4
.PP
Compute the primorial of
.IR n :
the product of all prime numbers less than or equal to
.IR n .
For example, primorial(10) = 2 * 3 * 5 * 7 = 210.
Returns 1 for
.I n
< 2.
.RE
.\" -------------------------------------------------------------------------
.SS Number-Theoretic Functions
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_moebius(int *" out ", const arbint_t " n ")"
.RS 4
.PP
Compute the Mobius function mu(n):
.RS 4
.IP \(bu 2
mu(1) = 1
.IP \(bu 2
mu(n) = 0 if n has a squared prime factor
.IP \(bu 2
mu(n) = (-1)^k if n is a product of k distinct primes
.RE
.PP
Sets
.I *out
to -1, 0, or 1.
Returns
.B ARBINT_EDOM
if
.I n
<= 0.
.RE
.PP
.BI "arbint_err_t arbint_totient(arbint_t " rop ", const arbint_t " n ")"
.RS 4
.PP
Compute Euler's totient function phi(n): the count of integers
in [1, n] that are coprime to
.IR n .
Uses the product formula phi(n) = n * prod(1 - 1/p) over distinct prime factors p.
.I rop
may alias
.IR n .
Returns
.B ARBINT_EDOM
if
.I n
<= 0.
.RE
.PP
.BI "arbint_err_t arbint_jacobi(const arbint_t " a ", const arbint_t " n ", int *" out ")"
.RS 4
.PP
Compute the Jacobi symbol (a/n).
.I n
must be a positive odd integer.
Sets
.I *out
to -1, 0, or 1.
Uses quadratic reciprocity and supplementary laws for efficient computation.
.RE
.PP
.BI "arbint_err_t arbint_legendre(const arbint_t " a ", const arbint_t " p ", int *" out ")"
.RS 4
.PP
Compute the Legendre symbol (a/p) where
.I p
is an odd prime.
Equivalent to the Jacobi symbol when
.I p
is prime.
Sets
.I *out
to -1, 0, or 1.
.RE
.PP
.BI "arbint_err_t arbint_kronecker(const arbint_t " a ", const arbint_t " n ", int *" out ")"
.RS 4
.PP
Compute the Kronecker symbol (a/n), which generalizes the Jacobi symbol
to all integer arguments including even and negative
.IR n .
Sets
.I *out
to -1, 0, or 1.
.RE
.\" -------------------------------------------------------------------------
.SS Primality Testing
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_isprime(const arbint_t " n ", int " reps ", int *" out ")"
.RS 4
.PP
Test whether
.I n
is prime using the Miller-Rabin probabilistic primality test.
The
.I reps
parameter specifies the number of test rounds; more rounds reduce the
probability of false positives.
Recommended values: 15-25 for general use, 40+ for cryptographic applications.
.PP
Sets
.I *out
to:
.RS 4
.IP \(bu 2
2 if
.I n
is definitely prime (small values checked against a table)
.IP \(bu 2
1 if
.I n
is probably prime (passed all Miller-Rabin rounds)
.IP \(bu 2
0 if
.I n
is definitely composite
.RE
.PP
Numbers <= 1 are not considered prime.
.RE
.PP
.BI "arbint_err_t arbint_nextprime(arbint_t " rop ", const arbint_t " n ")"
.RS 4
.PP
Find the smallest prime number greater than
.IR n .
.I rop
may alias
.IR n .
Uses trial division for small factors and Miller-Rabin for primality testing.
.RE
.PP
.BI "arbint_err_t arbint_prevprime(arbint_t " rop ", const arbint_t " n ")"
.RS 4
.PP
Find the largest prime number less than
.IR n .
Returns
.B ARBINT_EDOM
if
.I n
<= 2 (no prime exists below 2).
.I rop
may alias
.IR n .
.RE
.\" -------------------------------------------------------------------------
.SS Modular Inverse
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_inv_mod(arbint_t " rop ", const arbint_t " a ", const arbint_t " m ")"
.RS 4
.PP
Compute the modular multiplicative inverse:
.IR rop " = " a "^(-1) mod " m .
The result satisfies
.IR a " * " rop " = 1 (mod " m ")."
.PP
Returns
.B ARBINT_EDOM
if gcd(a, m) != 1 (inverse does not exist).
Returns
.B ARBINT_EINVAL
if
.I m
<= 0.
.I rop
may alias
.I a
or
.IR m .
.RE
.PP
.BI "arbint_err_t arbint_inv_mod_u32(arbint_t " rop ", const arbint_t " a ", uint32_t " m ")"
.RS 4
.PP
32-bit modulus variant of
.BR arbint_inv_mod ().
.I rop
may alias
.IR a .
.RE
.\" -------------------------------------------------------------------------
.SS Factor Removal
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_removefactor_u32(arbint_t " rest ", uint32_t *" exp ", const arbint_t " n ", uint32_t " f ")"
.RS 4
.PP
Remove all powers of factor
.I f
from
.IR n .
Sets
.I rest
to the remaining cofactor and
.I *exp
to the number of times
.I f
divides
.IR n .
.PP
For example, removefactor(72, 2) sets rest = 9 and *exp = 3,
since 72 = 2^3 * 9.
.PP
Returns
.B ARBINT_EZERO
if
.I f
is 0 or 1.
.I rest
may alias
.IR n .
If
.I exp
is NULL, the exponent is not returned.
.RE
.\" -------------------------------------------------------------------------
.SS Perfect Power Tests
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_is_square(const arbint_t " a ", int *" out ")"
.RS 4
.PP
Set
.I *out
to 1 if
.I a
is a perfect square, 0 otherwise.
Returns
.B ARBINT_EDOM
if
.I a
is negative.
.RE
.PP
.BI "arbint_err_t arbint_is_power(const arbint_t " a ", uint32_t *" exp ")"
.RS 4
.PP
Test whether |a| is a perfect power.
If |a| = b^k for some integer b and k >= 2, sets
.I *exp
to the smallest such k.
Otherwise, sets
.I *exp
to 0.
.PP
Special cases:
.RS 4
.IP \(bu 2
0 and +/-1 are considered perfect powers (any exponent works);
returns 1.
.IP \(bu 2
Negative inputs: only odd exponents are valid.
Returns 0 for negative numbers that are only even powers.
.IP \(bu 2
Composite exponents are detected: 64 = 2^6 returns 6, not 2.
.RE
.PP
The algorithm uses a static table of 97 primes (up to 521) for fast
small-exponent testing, with a dynamically cached sieve for larger
prime exponents.
GMP-compatible interface.
.RE
.\" -------------------------------------------------------------------------
.SS Division
.\" -------------------------------------------------------------------------
.PP
All division operations use
.B truncated division
semantics:
.PP
.RS 4
.nf
q = trunc(n / d)
r = n - q * d
.fi
.RE
.PP
The remainder
.I r
satisfies |r| < |d| and has the same sign as the dividend
.I n
(or is zero).
.PP
.B Full-precision division:
.PP
.nf
.BI "arbint_err_t arbint_tdiv_qr(arbint_t " q ", arbint_t " r ", const arbint_t " n ", const arbint_t " d ")"
.BI "arbint_err_t arbint_tdiv_q(arbint_t " q ", const arbint_t " n ", const arbint_t " d ")"
.BI "arbint_err_t arbint_tdiv_r(arbint_t " r ", const arbint_t " n ", const arbint_t " d ")"
.fi
.PP
.B 32-bit divisor variants:
.PP
.nf
.BI "arbint_err_t arbint_tdiv_qr_u32(arbint_t " q ", uint32_t *" r ", const arbint_t " n ", uint32_t " d ")"
.BI "arbint_err_t arbint_tdiv_q_u32(arbint_t " q ", const arbint_t " n ", uint32_t " d ")"
.BI "arbint_err_t arbint_tdiv_r_u32(uint32_t *" r ", const arbint_t " n ", uint32_t " d ")"
.BI "arbint_err_t arbint_tdiv_qr_i32(arbint_t " q ", int32_t *" r ", const arbint_t " n ", int32_t " d ")"
.BI "arbint_err_t arbint_tdiv_q_i32(arbint_t " q ", const arbint_t " n ", int32_t " d ")"
.BI "arbint_err_t arbint_tdiv_r_i32(int32_t *" r ", const arbint_t " n ", int32_t " d ")"
.fi
.RS 4
.PP
Single-limb division uses reciprocal-based algorithms (Granlund-Montgomery
technique) for significantly faster performance than hardware DIV.
.RE
.\" -------------------------------------------------------------------------
.SS Floor Division
.\" -------------------------------------------------------------------------
.PP
Floor division rounds the quotient toward negative infinity:
.PP
.RS 4
.nf
q = floor(n / d)
r = n - q * d
.fi
.RE
.PP
The remainder
.I r
has the same sign as the divisor
.I d
(or is zero).
.PP
.B Full-precision floor division:
.PP
.nf
.BI "arbint_err_t arbint_fdiv_qr(arbint_t " q ", arbint_t " r ", const arbint_t " n ", const arbint_t " d ")"
.BI "arbint_err_t arbint_fdiv_q(arbint_t " q ", const arbint_t " n ", const arbint_t " d ")"
.BI "arbint_err_t arbint_fdiv_r(arbint_t " r ", const arbint_t " n ", const arbint_t " d ")"
.fi
.PP
.B 32-bit divisor variants:
.PP
.nf
.BI "arbint_err_t arbint_fdiv_qr_u32(arbint_t " q ", uint32_t *" r ", const arbint_t " n ", uint32_t " d ")"
.BI "arbint_err_t arbint_fdiv_q_u32(arbint_t " q ", const arbint_t " n ", uint32_t " d ")"
.BI "arbint_err_t arbint_fdiv_r_u32(uint32_t *" r ", const arbint_t " n ", uint32_t " d ")"
.BI "arbint_err_t arbint_fdiv_qr_i32(arbint_t " q ", int32_t *" r ", const arbint_t " n ", int32_t " d ")"
.BI "arbint_err_t arbint_fdiv_q_i32(arbint_t " q ", const arbint_t " n ", int32_t " d ")"
.BI "arbint_err_t arbint_fdiv_r_i32(int32_t *" r ", const arbint_t " n ", int32_t " d ")"
.fi
.\" -------------------------------------------------------------------------
.SS Ceiling Division
.\" -------------------------------------------------------------------------
.PP
Ceiling division rounds the quotient toward positive infinity:
.PP
.RS 4
.nf
q = ceil(n / d)
r = n - q * d
.fi
.RE
.PP
The remainder
.I r
has the opposite sign of the divisor
.I d
(or is zero).
.PP
.B Full-precision ceiling division:
.PP
.nf
.BI "arbint_err_t arbint_cdiv_qr(arbint_t " q ", arbint_t " r ", const arbint_t " n ", const arbint_t " d ")"
.BI "arbint_err_t arbint_cdiv_q(arbint_t " q ", const arbint_t " n ", const arbint_t " d ")"
.BI "arbint_err_t arbint_cdiv_r(arbint_t " r ", const arbint_t " n ", const arbint_t " d ")"
.fi
.PP
.B 32-bit divisor variants:
.PP
.nf
.BI "arbint_err_t arbint_cdiv_qr_u32(arbint_t " q ", uint32_t *" r ", const arbint_t " n ", uint32_t " d ")"
.BI "arbint_err_t arbint_cdiv_q_u32(arbint_t " q ", const arbint_t " n ", uint32_t " d ")"
.BI "arbint_err_t arbint_cdiv_r_u32(uint32_t *" r ", const arbint_t " n ", uint32_t " d ")"
.BI "arbint_err_t arbint_cdiv_qr_i32(arbint_t " q ", int32_t *" r ", const arbint_t " n ", int32_t " d ")"
.BI "arbint_err_t arbint_cdiv_q_i32(arbint_t " q ", const arbint_t " n ", int32_t " d ")"
.BI "arbint_err_t arbint_cdiv_r_i32(int32_t *" r ", const arbint_t " n ", int32_t " d ")"
.fi
.\" -------------------------------------------------------------------------
.SS Divisibility Testing
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_divisible(const arbint_t " n ", const arbint_t " d ", int *" out ")"
.br
.BI "arbint_err_t arbint_divisible_u32(const arbint_t " n ", uint32_t " d ", int *" out ")"
.RS 4
.PP
Test whether
.I d
divides
.I n
exactly.
On success, sets
.I *out
to 1 if divisible (remainder is zero), 0 otherwise.
Divisibility is tested on magnitudes; signs are ignored.
Zero is divisible by any nonzero divisor.
Returns
.B ARBINT_EZERO
if
.I d
is zero.
.PP
These functions avoid computing the full quotient when possible.
For power-of-two divisors, divisibility is checked in O(1) time by
examining trailing zero bits.
For general divisors,
.BR arbint_divisible_u32 ()
uses Barrett reduction to compute the remainder without division instructions.
.RE
.\" -------------------------------------------------------------------------
.SS Bit Shifts
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_shl(arbint_t " rop ", const arbint_t " a ", uint32_t " k ")"
.RS 4
.PP
Compute
.IR rop " = " a " * 2^" k .
Sign is preserved.
.I rop
may alias
.IR a .
.RE
.PP
.BI "arbint_err_t arbint_shr(arbint_t " rop ", const arbint_t " a ", uint32_t " k ")"
.RS 4
.PP
Compute
.IR rop " = " a " / 2^" k
(truncated toward zero).
Sign is preserved.
.I rop
may alias
.IR a .
.RE
.\" -------------------------------------------------------------------------
.SS Bit Queries
.\" -------------------------------------------------------------------------
.PP
.BI "size_t arbint_sizeinbase(const arbint_t " x ", int " base ")"
.RS 4
.PP
Return digits needed to represent
.I x
in the given
.I base
(2-62).
Returns 1 for zero.
.RE
.PP
.BI "size_t arbint_nbits(const arbint_t " x ")"
.RS 4
.PP
Return the number of significant bits (position of highest set bit + 1).
Returns 0 for zero.
.RE
.PP
.B Two's-complement operations:
.PP
The following functions operate on infinite sign-extended two's-complement
representations, then normalize results back to sign-magnitude form.
.PP
.BI "arbint_err_t arbint_testbit(const arbint_t " x ", size_t " idx ", int *" out ")"
.br
.BI "arbint_err_t arbint_setbit(arbint_t " x ", size_t " idx ")"
.br
.BI "arbint_err_t arbint_clrbit(arbint_t " x ", size_t " idx ")"
.RS 4
.PP
Test, set, or clear bit
.I idx
(zero-indexed from LSB).
.RE
.PP
.BI "arbint_err_t arbint_ctz(const arbint_t " x ", size_t *" out ")"
.br
.BI "arbint_err_t arbint_clz(const arbint_t " x ", size_t *" out ")"
.RS 4
.PP
Count trailing or leading zero bits.
Returns
.B ARBINT_EDOM
for zero input.
For negative values,
.BR arbint_clz ()
returns 0 (MSB is always set).
.RE
.PP
.BI "arbint_err_t arbint_popcount(const arbint_t " x ", size_t *" out ")"
.br
.BI "arbint_err_t arbint_hammingdist(const arbint_t " a ", const arbint_t " b ", size_t *" out ")"
.RS 4
.PP
Population count and Hamming distance.
Hardware POPCNT is used when available (threshold: 8 limbs).
.RE
.\" -------------------------------------------------------------------------
.SS Bitwise Logic
.\" -------------------------------------------------------------------------
.PP
All bitwise operations use two's-complement semantics.
.PP
.BI "arbint_err_t arbint_and(arbint_t " rop ", const arbint_t " a ", const arbint_t " b ")"
.br
.BI "arbint_err_t arbint_or(arbint_t " rop ", const arbint_t " a ", const arbint_t " b ")"
.br
.BI "arbint_err_t arbint_xor(arbint_t " rop ", const arbint_t " a ", const arbint_t " b ")"
.br
.BI "arbint_err_t arbint_not(arbint_t " rop ", const arbint_t " a ")"
.RS 4
.PP
Bitwise AND, OR, XOR, and NOT.
.BR arbint_not ()
computes two's-complement NOT, equivalent to \-(\fIa\fP + 1).
.I rop
may alias inputs.
.RE
.PP
.B Scalar variants:
.PP
.TS
tab(|);
lb lb lb
l l l.
Operation|Signed (i32)|Unsigned (u32)
_
AND|arbint_and_i32|arbint_and_u32
OR|arbint_or_i32|arbint_or_u32
XOR|arbint_xor_i32|arbint_xor_u32
.TE
.PP
Signed variants sign-extend the scalar; unsigned variants zero-extend.
.\" -------------------------------------------------------------------------
.SS GCD and LCM
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_gcd(arbint_t " g ", const arbint_t " a ", const arbint_t " b ")"
.RS 4
.PP
Compute
.IR g " = gcd(" a ", " b ")."
The result is always non-negative.
Signs of inputs are ignored (operates on magnitudes).
.I g
may alias
.I a
or
.IR b .
.PP
.BR gcd(0, 0) " = 0."
.BR gcd(0, " n ") = gcd(" n ", 0) = |" n "|."
.RE
.PP
.BI "arbint_err_t arbint_lcm(arbint_t " l ", const arbint_t " a ", const arbint_t " b ")"
.RS 4
.PP
Compute
.IR l " = lcm(" a ", " b ")."
The result is always non-negative.
If either operand is zero, the result is zero.
.I l
may alias
.I a
or
.IR b .
.PP
.BR "Identity: gcd(" a ", " b ") * lcm(" a ", " b ") = |" a "| * |" b "|."
.RE
.PP
.BI "arbint_err_t arbint_gcd_u32(arbint_t " g ", const arbint_t " a ", uint32_t " b ")"
.br
.BI "arbint_err_t arbint_lcm_u32(arbint_t " l ", const arbint_t " a ", uint32_t " b ")"
.RS 4
.PP
32-bit scalar variants.
.I g
or
.I l
may alias
.IR a .
.RE
.PP
.BI "arbint_err_t arbint_xgcd(arbint_t " g ", arbint_t " x ", arbint_t " y ", const arbint_t " a ", const arbint_t " b ")"
.RS 4
.PP
Extended GCD: compute
.IR g " = gcd(" a ", " b ")"
and Bezout coefficients
.IR x ", " y
such that
.IR a "*" x " + " b "*" y " = " g .
.PP
Any of
.IR g ", " x ", " y
may be NULL if the corresponding output is not needed.
When only
.I g
and
.I x
are requested (y is NULL), computes
.IR x " = " a "^(-1) mod " b
for coprime inputs.
.PP
The result
.I g
is always non-negative.
Signs of
.I x
and
.I y
are determined by the extended Euclidean algorithm.
.PP
.B Aliasing:
All output parameters may alias input parameters or each other.
When outputs alias, "last write wins" semantics apply (the final
value is whichever output is written last).
.PP
.B Special cases:
.RS 4
.IP \(bu 2
gcd(0, 0) = 0, with x = y = 0.
.IP \(bu 2
gcd(a, 0) = |a|, with x = sign(a), y = 0.
.IP \(bu 2
gcd(0, b) = |b|, with x = 0, y = sign(b).
.RE
.RE
.\" -------------------------------------------------------------------------
.SS Random Number Generation
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_rng_init(arbint_rng_t *" rng ", const void *" seed ", size_t " seed_len ")"
.RS 4
.PP
Initialize MT19937 PRNG state.
If
.I seed
is NULL, uses platform entropy (see
.BR "ENTROPY SOURCES" ).
Otherwise,
.I seed
must point to
.I seed_len
bytes where
.I seed_len
is a positive multiple of 4.
.PP
Returns
.B ARBINT_EINVAL
if no entropy source is available (when
.I seed
is NULL) or if
.I seed_len
is invalid.
Returns
.B ARBINT_EDOM
if the platform entropy source fails at runtime.
.RE
.PP
.BI "void arbint_rng_clear(arbint_rng_t *" rng ")"
.RS 4
.PP
Securely zero the PRNG state to prevent leakage.
.RE
.PP
.BI "arbint_err_t arbint_urandomb(arbint_t " rop ", arbint_rng_t *" rng ", size_t " k ")"
.RS 4
.PP
Set
.I rop
to a uniform random integer in [0, 2^\fIk\fP).
.RE
.PP
.BI "arbint_err_t arbint_urandomm(arbint_t " rop ", arbint_rng_t *" rng ", const arbint_t " bound ")"
.RS 4
.PP
Set
.I rop
to a uniform random integer in [0,
.IR bound ).
Uses rejection sampling to eliminate modulo bias.
.I rop
may alias
.IR bound .
Returns
.B ARBINT_EDOM
if
.I bound
<= 0.
.RE
.\" -------------------------------------------------------------------------
.SS Hashing
.\" -------------------------------------------------------------------------
.PP
Both hash functions are designed for hash-table use.
.B The algorithm and output are intentionally unstable
across library versions and process runs.
.PP
.BI "arbint_err_t arbint_hash_slow(const arbint_t " op ", uint8_t *" out ", size_t " len ")"
.RS 4
.PP
Cryptographic-quality hash using SHA-256.
For
.I len
<= 32, output is a (possibly truncated) SHA-256 digest.
For
.I len
> 32, counter-mode extension is used.
Hardware SHA-NI acceleration when available.
.RE
.PP
.BI "arbint_err_t arbint_hash_fast(const arbint_t " op ", uint32_t *" out ")"
.RS 4
.PP
Fast non-cryptographic hash using CRC32C (Castagnoli polynomial).
Hardware SSE4.2 (x86) or CRC32/PMULL (AArch64) acceleration when available.
.RE
.\" -------------------------------------------------------------------------
.SS Binary Import/Export
.\" -------------------------------------------------------------------------
.PP
.BI "arbint_err_t arbint_import(arbint_t " rop ", const void *" buf ", size_t " len ", int " sign ")"
.RS 4
.PP
Set
.I rop
from a little-endian magnitude byte buffer with explicit
.I sign
(\-1, 0, or +1).
.RE
.PP
.BI "arbint_err_t arbint_export(void **" buf ", size_t *" len ", const arbint_t " op ")"
.RS 4
.PP
Export magnitude to a little-endian byte buffer (no sign encoding).
The buffer is allocated using the source object's context allocator;
the caller must free it with the same allocator.
.RE
.\" =========================================================================
.\"                          ALIASING RULES
.\" =========================================================================
.SH ALIASING RULES
.PP
.B Single-output operations:
The destination may alias any input operand.
The library handles internal copying when necessary.
.PP
.B Two-output division:
Both
.I q
and
.I r
may alias inputs or each other.
If both outputs are the same object, the value of the last-written
output (the remainder) remains.
.\" =========================================================================
.\"                        ALGORITHMS
.\" =========================================================================
.SH ALGORITHMS
.\" -------------------------------------------------------------------------
.SS Multiplication
.\" -------------------------------------------------------------------------
Four algorithms are selected based on operand size:
.PP
.RS 4
.TS
tab(|);
lb lb lb
l l l.
Algorithm|Threshold|Complexity
_
Schoolbook|< 15 limbs|O(n^2)
Karatsuba|>= 15 limbs|O(n^1.585)
Toom-Cook 3|>= 20 limbs|O(n^1.465)
NTT|>= 1024 limbs|O(n log n)
.TE
.RE
.PP
The NTT (Number Theoretic Transform) algorithm uses 3-prime CRT reconstruction
with Goldilocks-family primes (p1 = 2^64 - 2^32 + 1, p2, p3).
Montgomery arithmetic enables efficient modular multiplication without division.
Cooley-Tukey radix-2 decimation-in-time butterflies with precomputed roots of
unity.
Garner's algorithm reconstructs the final result from the three residues.
.PP
Scalar multiplication by a power of two is detected and delegated to
.BR arbint_shl ()
as a fast path.
.\" -------------------------------------------------------------------------
.SS Squaring
.\" -------------------------------------------------------------------------
.PP
Exploits the symmetry
.IR a[i]*a[j] " == " a[j]*a[i]
to halve cross-product multiplications.
For large operands, the recursive identity
.IR a "^2 = " a1 "^2*B^(2k) + ((" a0 "+" a1 ")^2 - " a0 "^2 - " a1 "^2)*B^k + " a0 "^2"
requires only three half-size squarings instead of four multiplications.
.\" -------------------------------------------------------------------------
.SS Division
.\" -------------------------------------------------------------------------
.PP
.B Power-of-two:
When the divisor is a power of two (2^k), division is performed via
bit shifts and masks instead of full division:
quotient = n >> k,
remainder = n & (2^k - 1).
This optimization applies to all division modes (truncated, floor, ceiling)
and handles both single-limb and multi-limb power-of-two divisors.
.PP
.B Multi-limb:
Knuth's Algorithm D (TAOCP Vol 2, Section 4.3.1) with reciprocal-based
quotient estimation.
Complexity is O(n*m) for n-limb dividend and m-limb divisor.
.PP
.B Single-limb:
Granlund-Montgomery reciprocal technique replaces expensive hardware DIV
with two multiplications per limb.
.\" -------------------------------------------------------------------------
.SS Exponentiation
.\" -------------------------------------------------------------------------
.PP
Binary exponentiation (right-to-left repeated squaring) requiring at most
2 * log2(\fIexp\fP) multiplications.
.PP
Modular exponentiation precomputes the Barrett reciprocal once and reuses
it for all reductions, avoiding 2k redundant reciprocal computations for
a k-bit exponent.
.\" -------------------------------------------------------------------------
.SS Integer Square Root
.\" -------------------------------------------------------------------------
.PP
Newton's method on the iteration
x_{n+1} = floor((x_n + floor(a / x_n)) / 2),
starting from x_0 = 2^ceil(nbits(a)/2).
Quadratic convergence yields O(log nbits(a)) iterations, each dominated
by one truncated division.
.\" -------------------------------------------------------------------------
.SS GCD and LCM
.\" -------------------------------------------------------------------------
.PP
.B Small operands (<= 4 limbs):
Euclidean algorithm with modular reduction.
For size-disparate operands (one much larger than the other), a modular
reduction step first brings them to similar size.
.PP
.B Medium operands (5-31 limbs):
Binary GCD (Stein's algorithm) exploiting the identity
gcd(2a, 2b) = 2*gcd(a, b) and gcd(a, b) = gcd(a-b, b) for odd a, b.
Requires only shifts and subtractions, avoiding expensive divisions.
.PP
.B Large operands (>= 32 limbs):
Lehmer GCD algorithm extracts the top bits of both operands into machine
words and computes a sequence of quotients using single-precision arithmetic.
These quotients define a 2x2 matrix that is applied to the full-precision
operands in one step, reducing their size by approximately one word per
iteration.
Asymptotically faster than binary GCD for very large operands.
.PP
.B Extended GCD:
Uses the standard extended Euclidean algorithm, tracking the transformation
matrix to compute Bezout coefficients alongside the GCD.
.PP
.B LCM:
Computed as lcm(a, b) = |a| * |b| / gcd(a, b), with division performed
after the GCD to avoid intermediate overflow.
.\" =========================================================================
.\"                       ENTROPY SOURCES
.\" =========================================================================
.SH ENTROPY SOURCES
.PP
When
.BR arbint_rng_init ()
is called with a NULL seed, entropy is obtained from the best
available platform source (selected at compile time):
.PP
.TS
tab(|);
lb lb
l l.
Platform|Source
_
Windows|T{
BCryptGenRandom (Vista+), CryptGenRandom (XP+),
or RtlGenRandom (XP+, via advapi32.dll)
T}
macOS/BSD|arc4random_buf (kernel-seeded, cannot fail)
Linux/POSIX|/dev/urandom (opened/read/closed per call)
.TE
.PP
If no entropy source was detected at configure time or was disabled with
.BR \-\-disable-entropy ,
NULL-seed initialization returns
.BR ARBINT_EINVAL .
.\" =========================================================================
.\"                      CONFIGURE OPTIONS
.\" =========================================================================
.SH CONFIGURE OPTIONS
.TP
.B \-\-disable\-entropy
Do not compile any platform entropy source.
.BR arbint_rng_init ()
with NULL seed will return
.BR ARBINT_EINVAL ;
callers must provide their own seed buffer.
.\" =========================================================================
.\"                         EXAMPLE
.\" =========================================================================
.SH EXAMPLE
.PP
.nf
.in +4
#include <arbint.h>

int main(void) {
    arbint_ctx_t ctx;
    arbint_t a, b, q, r;

    arbint_ctx_init_default(&ctx);
    arbint_init_all(&ctx, a, b, q, r, (arbint_t *) NULL);

    arbint_set_i32(a, -17);
    arbint_set_i32(b, 5);
    arbint_tdiv_qr(q, r, a, b);  /* q = -3, r = -2 */

    arbint_clear_all(a, b, q, r, (arbint_t *) NULL);
    return 0;
}
.in -4
.fi
