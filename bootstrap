#!/bin/sh
# bootstrap - prepare c-arbint for building from a git checkout
#
# Copyright (C) 2026 Kamila Szewczyk (k@iczelia.net)
# SPDX-License-Identifier: AGPL-3.0-or-later

set -eu

# Generate platform-specific Makefile rules before automake runs.
# This is needed because automake parses include directives at autoreconf time.
#
# The generator reads src/platform-objects.txt and produces rules with:
#   - Conditional LIBADD entries
#   - Compilation rules with optional per-file CFLAGS
#   - Dependency tracking when AMDEP is enabled (GCC/Clang)
#   - Clean compilation when AMDEP is disabled (tcc, old MSVC)

echo "Generating src/Makefile.platform-rules.am..."

input="src/platform-objects.txt"
output="src/Makefile.platform-rules.am"

cat > "$output" <<'HEADER'
# Generated by bootstrap - DO NOT EDIT
#
# This file is included by src/Makefile.am and provides compilation rules
# for platform-specific object files with conditional dependency tracking.

HEADER

dep_files=""

while read -r name cond cflags rest; do
    # Skip empty lines and comments
    case "$name" in
        ''|\#*) continue ;;
    esac

    dep_files="$dep_files \$(DEPDIR)/libarbint_la-${name}.Plo"

    # Handle optional cflags (default to empty)
    if [ -z "$cflags" ]; then
        cflags_ref=""
    else
        cflags_ref="\$(${cflags}) "
    fi

    cat >> "$output" <<EOF
if ${cond}
libarbint_la_LIBADD += libarbint_la-${name}.lo
endif

@AMDEP_TRUE@libarbint_la-${name}.lo: ${name}.c
@AMDEP_TRUE@	\$(ARBINT_LTCOMPILE) ${cflags_ref}-MD -MF \$(DEPDIR)/libarbint_la-${name}.Tpo -c -o \$@ \`test -f '\$<' || echo '\$(srcdir)/'\`\$<
@AMDEP_TRUE@	\$(am__mv) \$(DEPDIR)/libarbint_la-${name}.Tpo \$(DEPDIR)/libarbint_la-${name}.Plo

@AMDEP_FALSE@libarbint_la-${name}.lo: ${name}.c
@AMDEP_FALSE@	\$(ARBINT_LTCOMPILE) ${cflags_ref}-c -o \$@ \`test -f '\$<' || echo '\$(srcdir)/'\`\$<

@AMDEP_TRUE@-include \$(DEPDIR)/libarbint_la-${name}.Plo

EOF
done < "$input"

# Add distclean rule for generated dependency files
cat >> "$output" <<EOF
# Clean up generated dependency files
DISTCLEANFILES =$dep_files
EOF

autoreconf -fi

echo "Bootstrap complete. Now run: ./configure && make"
